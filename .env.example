# Copy this file to .env and fill in your own keys. Never commit .env.

# Required - LLM inference via Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional - IP reputation lookups (https://www.abuseipdb.com/account/api)
# If unset, the IP Reputation tool is skipped gracefully.
ABUSEIPDB_API_KEY=

# Optional - override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional - log entries per analyst batch (lower it if you hit tokens-per-minute limits)
# ANALYSIS_BATCH_SIZE=3

# Quality-of-life settings
HF_HUB_DISABLE_SYMLINKS_WARNING=1
LITELLM_CACHE=False
